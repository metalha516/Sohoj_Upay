# Local Development Docker Compose Override
# To expose database and Redis ports on your host machine for debugging tools (e.g. TablePlus, DBeaver):
#   cp docker-compose.override.yml.example docker-compose.override.yml
# NOTE: docker-compose.override.yml is git-ignored and MUST NEVER be committed.

services:
  postgres:
    ports:
      - "127.0.0.1:5432:5432"

  redis:
    ports:
      - "127.0.0.1:6379:6379"
