# -----------------------------------------------------------------------------
# AI Financial Coach (Sohoj) - Environment Configuration Template
# NOTE: This file contains ONLY non-secret placeholders and defaults.
# Copy this file to .env and set secure values for local development.
# -----------------------------------------------------------------------------

# Application
ENVIRONMENT=local
DEBUG=false
APP_NAME="AI Financial Coach"
API_V1_PREFIX=/api/v1
SECRET_KEY=change_me_to_at_least_32_characters_random_secret_key

# PostgreSQL (pgvector)
POSTGRES_USER=financial_app
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_DB=financial_coach
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://financial_app:replace_with_secure_postgres_password@postgres:5432/financial_coach

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# Security & Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS (JSON string array)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# LLM Configuration (External Provider / Mock / Gemini)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-flash-latest
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-flash-latest
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=10.0

# Administrative
ADMIN_API_KEY=admin_master_secret_override_key_99

# Kill Switches & Feature Flags
AI_ENABLED=true
REGISTRATION_ENABLED=true
LOGIN_ENABLED=true
FORECAST_ENABLED=true

# Monitoring (Grafana Admin)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace_with_secure_grafana_password
